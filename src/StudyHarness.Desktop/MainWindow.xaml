<Window x:Class="StudyHarness.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StudyHarness.Desktop"
        Title="Deep Study" Icon="Assets/deep-study.ico" Width="1340" Height="900" MinWidth="980" MinHeight="720"
        Background="{StaticResource DsPageBrush}" FontFamily="{StaticResource DsFont}" FontSize="13.5"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource DsSidebarBrush}" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <Border Width="46" Height="46" CornerRadius="16" Background="White" Effect="{StaticResource DsCardShadow}">
                            <Image Source="Assets/deep-study.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Deep Study 读书鲸"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Deep Study" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DsPrimaryBrush}" TextWrapping="NoWrap"/>
                            <TextBlock Text="让好奇成为日常" Style="{StaticResource DsCaption}" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="工 作 台" Style="{StaticResource DsSectionLabel}" Margin="14,32,0,10"/>
                    <Button x:Name="NavChatButton" Style="{StaticResource NavButton}" Click="Chat_Click" AutomationProperties.AutomationId="NavChat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" Style="{StaticResource DsIconGlyph}"/>
                            <TextBlock Text="主对话" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavCoursesButton" Style="{StaticResource NavButton}" Click="Courses_Click" AutomationProperties.AutomationId="NavCourses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource DsIconGlyph}"/>
                            <TextBlock Text="课程" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Click="Settings_Click" AutomationProperties.AutomationId="NavSettings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource DsIconGlyph}"/>
                            <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource DsIconGlyph}" FontSize="12" Foreground="{StaticResource DsSuccessBrush}"/>
                                <TextBlock Text="本地优先" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DsBodyBrush}" Margin="7,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="资料与记录只保存在本机。" Style="{StaticResource DsCaption}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="DEEP STUDY" Style="{StaticResource DsSectionLabel}" Margin="4,0,0,2"/>
                    <TextBlock Text="你的学习，从这里继续" Style="{StaticResource DsCaption}" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer local:SmoothScroll.Enabled="True" x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,28,32,32" MaxWidth="1040" HorizontalAlignment="Stretch">
                    <!-- ===== Main conversation ===== -->
                    <StackPanel local:SubtleMotion.Enabled="True" x:Name="ChatPanel">
                        <Border Background="{StaticResource DsHeroGradient}" BorderBrush="{StaticResource DsPrimaryLineBrush}" BorderThickness="1" CornerRadius="22" Padding="30,26" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="学 习 规 划" Style="{StaticResource DsSectionLabel}" Foreground="{StaticResource DsPrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="今天，想学些什么？" Style="{StaticResource DsDisplay}"/>
                                    <TextBlock Text="写下一个目标，Deep Study 会把它拆成一条可以随时继续的学习路线。" Style="{StaticResource DsBody}" Foreground="{StaticResource DsMutedBrush}" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Border Style="{StaticResource DsChipPrimary}" Margin="0,0,8,0"><TextBlock Text="1  描述目标" Style="{StaticResource DsCaption}" Foreground="{StaticResource DsPrimaryBrush}"/></Border>
                                        <Border Style="{StaticResource DsChipPrimary}" Margin="0,0,8,0"><TextBlock Text="2  准备资料" Style="{StaticResource DsCaption}" Foreground="{StaticResource DsPrimaryBrush}"/></Border>
                                        <Border Style="{StaticResource DsChipPrimary}"><TextBlock Text="3  确认计划" Style="{StaticResource DsCaption}" Foreground="{StaticResource DsPrimaryBrush}"/></Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Width="104" Height="104" CornerRadius="30" Background="White" Effect="{StaticResource DsCardShadow}" VerticalAlignment="Center" Margin="26,0,4,0">
                                    <Image Source="Assets/deep-study.png" Width="72" Height="72" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DsCard}" Padding="26">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="学习请求" Style="{StaticResource DsH2}"/>
                                        <TextBlock Text="越具体越好：想学什么、想达到什么程度、有多少时间。" Style="{StaticResource DsCaption}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RecoveryStatus}" Style="{StaticResource DsCaption}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <TextBox x:Name="RequestBox" Text="{Binding Request,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="104" MaxHeight="190" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="PlanRequest"/>
                                    <TextBlock IsHitTestVisible="False" Text="例如：我想用 6 周入门线性代数，能看懂矩阵、秩与特征值，每周大约 5 小时。" Margin="14,12,40,0" VerticalAlignment="Top" Foreground="{StaticResource DsFaintBrush}" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RequestBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource SuggestionChip}" Content="线性代数入门" Tag="我想系统入门线性代数，理解矩阵、行列式与特征值。" Click="Suggest_Click"/>
                                    <Button Style="{StaticResource SuggestionChip}" Content="算法竞赛基础" Tag="我想入门算法竞赛，掌握排序、二分与基础数据结构。" Click="Suggest_Click"/>
                                    <Button Style="{StaticResource SuggestionChip}" Content="C 语言指针" Tag="我想彻底弄懂 C 语言的指针与内存管理。" Click="Suggest_Click"/>
                                    <Button Style="{StaticResource SuggestionChip}" Content="高等数学复习" Tag="我想复习高等数学的极限、导数与积分，准备考试。" Click="Suggest_Click"/>
                                </WrapPanel>

                                <Expander x:Name="DetailsExpander" AutomationProperties.AutomationId="DetailsOptions" Margin="0,8,0,10">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource DsPrimarySoftBrush}">
                                                <TextBlock Text="&#xE70F;" Style="{StaticResource DsIconGlyph}" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="更多细节" Style="{StaticResource DsH3}"/>
                                                <TextBlock Text="已有基础、具体目标与每周投入（选填）" Style="{StaticResource DsCaption}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="已有基础" Style="{StaticResource DsLabel}"/><TextBox Text="{Binding Background,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PlanBackground"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="每周投入（小时）" Style="{StaticResource DsLabel}"/><TextBox Text="{Binding Hours,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PlanHours"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="具体目标" Style="{StaticResource DsLabel}" Margin="0,6,0,6"/>
                                        <TextBox Text="{Binding Goal,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PlanGoal"/>
                                    </StackPanel>
                                </Expander>

                                <Expander AutomationProperties.AutomationId="WebOptions">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource DsPrimarySoftBrush}">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource DsIconGlyph}" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="联网寻找学习资料" Style="{StaticResource DsH3}"/>
                                                <TextBlock Text="从公开网页取得正文，作为当前计划的固定来源（选填）" Style="{StaticResource DsCaption}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="搜索主题（留空时使用学习请求）" Style="{StaticResource DsLabel}"/>
                                        <TextBox Text="{Binding WebTopic,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WebTopic"/>
                                        <TextBlock Text="指定站点或正文 URL（可选）" Style="{StaticResource DsLabel}"/>
                                        <TextBox Text="{Binding WebSite,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WebSite"/>
                                        <Border Style="{StaticResource DsSoftPanel}" Margin="0,4,0,12">
                                            <TextBlock Text="点击后会向 DeepSeek 发送主题与公开网址，最多 2 次搜索和 3 次抓取，按服务商计费。" Style="{StaticResource DsSmall}"/>
                                        </Border>
                                        <Button Content="同意联网并获取资料" Click="AcquireWeb_Click" AutomationProperties.AutomationId="AcquireWeb" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"/>
                                        <Expander x:Name="WebSourcesExpander" Header="查看来源详情" Margin="0,12,0,0">
                                            <TextBox Text="{Binding WebReport,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="WebSourceReport" Background="{StaticResource DsSurfaceAltBrush}"/>
                                        </Expander>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ImportExpander" AutomationProperties.AutomationId="ImportOptions" IsEnabled="{Binding CanEdit}">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource DsPrimarySoftBrush}">
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource DsIconGlyph}" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="导入自己的资料" Style="{StaticResource DsH3}"/>
                                                <TextBlock Text="PDF、PPT、Markdown 与 .c/.cpp 源文件，只读导入（选填）" Style="{StaticResource DsCaption}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel x:Name="WorkspacePanel">
                                        <TextBlock Text="支持 PDF、PPT、PPTX、Markdown、.c、.cpp。PPTX文字、表格和备注直接提取，图示页在线识别；旧PPT转换和幻灯片读图需要Microsoft PowerPoint。已完成页复用缓存。待识别页全部发送至DeepSeek识别。在线识别使用已配置模型并产生API费用；PPT默认8页并行，可选16页，PDF为8页并行。可取消并保留进度；原文件只读。" Style="{StaticResource DsSmall}"/>
                                        <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanImport}">
                                            <Button x:Name="ImportFileButton" Content="导入文件" Click="ImportFile_Click" AutomationProperties.AutomationId="ImportFile" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button Content="导入目录" Click="ImportFolder_Click" AutomationProperties.AutomationId="ImportFolder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ImportQueueText}" Style="{StaticResource DsSmall}" AutomationProperties.AutomationId="ImportQueue"/>
                                        <WrapPanel IsEnabled="{Binding CanResumeImports}">
                                            <Button Content="继续队列" Click="ResumeImports_Click" Style="{StaticResource SecondaryButton}" Margin="0,4,8,8"/>
                                            <Button Content="清空待处理队列" Click="ClearImports_Click" Style="{StaticResource GhostButton}" Margin="0,4,0,8"/>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding CanOperate}">
                                            <TextBlock Text="PPT扫描并发" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="PresentationConcurrencySelector" ItemsSource="{Binding PresentationConcurrencyChoices}" SelectedItem="{Binding PresentationConcurrency}" Width="80" AutomationProperties.AutomationId="PresentationConcurrency"/>
                                            <TextBlock Text="页 · 网络稳定时可选16；暂停后可调整" Style="{StaticResource DsSmall}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Materials}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource DsSoftPanel}" Padding="11,8" Margin="0,4">
                                                        <DockPanel LastChildFill="True">
                                                            <Button DockPanel.Dock="Right" Content="×" Click="RemoveMaterial_Click" AutomationProperties.AutomationId="RemoveMaterial" AutomationProperties.Name="从本次计划移除资料" ToolTip="仅移出本次计划；保留原文件和扫描结果，重新添加同一文件无需重复扫描已完成页。" Style="{StaticResource GhostButton}" Padding="8,2"/>
                                                            <Button DockPanel.Dock="Right" Content="继续扫描" Click="ContinueMaterialScan_Click" Visibility="{Binding NeedsScan,Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding DataContext.CanOperate,RelativeSource={RelativeSource AncestorType=ItemsControl}}" AutomationProperties.AutomationId="ContinueMaterialScan" Style="{StaticResource GhostButton}" Padding="8,2"/>
                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{StaticResource DsPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource DsSmall}" Margin="0,8,0,0" AutomationProperties.AutomationId="WorkspaceStatus"/>
                                        <Border Style="{StaticResource DsSoftPanel}" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="资料扫描进度" Style="{StaticResource DsH3}"/>
                                                <TextBlock Text="{Binding SelectedCollection.Label}" Style="{StaticResource DsSmall}" Margin="0,6,0,0"/>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanPercent, Mode=OneWay}" IsIndeterminate="{Binding ScanIndeterminate}" Height="18" Margin="0,10,0,6" AutomationProperties.AutomationId="PdfScanProgress"/>
                                                <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource DsSmall}" AutomationProperties.AutomationId="PdfScanProgressText"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="继续扫描" Click="ContinueScan_Click" IsEnabled="{Binding CanOperate}" Style="{StaticResource SecondaryButton}" AutomationProperties.AutomationId="ContinuePdfScan"/>
                                                    <Button Content="取消扫描（保留进度）" Click="CancelImport_Click" IsEnabled="{Binding Busy}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" AutomationProperties.AutomationId="CancelPdfScan"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <Grid Margin="0,14,0,0">
                                    <Button Content="形成发送内容" Click="PreparePlan_Click" IsEnabled="{Binding CanOperate}" AutomationProperties.AutomationId="PreparePlan" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="将保存草稿并生成完整的待发送预览。" Style="{StaticResource DsCaption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="SubmissionFeedback" Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource DsSmall}" Margin="0,8,0,0" AutomationProperties.AutomationId="SubmissionStatus"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="完整外发内容" IsExpanded="True" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="发送前可以在这里核对将要交给 DeepSeek 的全部内容。" Style="{StaticResource DsSmall}" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Preview,Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" MinHeight="90" MaxHeight="280" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="PlanPreview" FontFamily="{StaticResource DsMonoFont}" FontSize="12" Background="{StaticResource DsSurfaceAltBrush}"/>
                            </StackPanel>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{Binding SubmitPlanLabel}" Click="ProposePlan_Click" IsEnabled="{Binding CanSubmitPlan}" AutomationProperties.AutomationId="ProposePlan" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="拒绝发送" Click="DenyPlan_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="DenyPlan" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                            <Button Content="取消请求" Click="CancelPlan_Click" AutomationProperties.AutomationId="CancelPlan" Style="{StaticResource GhostButton}" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource DsSmall}" Foreground="{StaticResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" AutomationProperties.AutomationId="PlanningStatus"/>
                        </StackPanel>

                        <Grid Margin="2,26,2,12">
                            <StackPanel>
                                <TextBlock Text="完整待确认计划" Style="{StaticResource DsH1}"/>
                                <TextBlock Text="逐项核对目标、节奏与实验安排；确认后计划冻结，不可再修改。" Style="{StaticResource DsSmall}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource DsCard}" Padding="22">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="计 划 正 文" Style="{StaticResource DsSectionLabel}"/>
                                    <TextBlock Text="确认前请完整核对目标、节奏与来源。" Style="{StaticResource DsCaption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding Summary,Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" MinHeight="140" MaxHeight="420" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="PlanSummary" Background="{StaticResource DsSurfaceAltBrush}" BorderBrush="{StaticResource DsBorderBrush}" Padding="16"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="补充计划信息" AutomationProperties.AutomationId="OpenClarification" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="回答下面的问题后，重新形成发送内容即可继续拟定计划。" Style="{StaticResource DsSmall}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding ClarificationQuestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DsSoftPanel}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding}" Style="{StaticResource DsBody}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="你的回答" Style="{StaticResource DsLabel}" Margin="0,6,0,6"/>
                                <TextBox Text="{Binding ClarificationAnswer,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanClarify}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ClarificationAnswer"/>
                            </StackPanel>
                        </Expander>

                        <Border Style="{StaticResource DsHintPanel}" Margin="0,14,0,0" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="确认前请核对" Style="{StaticResource DsH3}" Foreground="{StaticResource DsPrimaryBrush}" Margin="0,0,0,10"/>
                                <CheckBox Content="我已核对完整计划，理解确认后不可修改" IsChecked="{Binding AckFrozen}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="AckFrozen"/>
                                <TextBlock Text="{Binding ConfirmationHint}" Style="{StaticResource DsSmall}" Margin="0,10,0,0" AutomationProperties.AutomationId="ConfirmationHint"/>
                                <Button Content="确认计划，开始学习" Click="ConfirmPlan_Click" IsEnabled="{Binding CanConfirm}" AutomationProperties.AutomationId="ConfirmPlan" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Courses ===== -->
                    <StackPanel local:SubtleMotion.Enabled="True" x:Name="CoursesPanel" Visibility="Collapsed">
                        <Grid x:Name="CoursesHeader" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="我的课程" Style="{StaticResource DsDisplay}"/>
                                <TextBlock Text="每一个已确认的计划，都会成为一条可以随时继续的学习路线。" Style="{StaticResource DsBody}" Foreground="{StaticResource DsMutedBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="CourseList"/>
                        <StackPanel x:Name="NoSubjects" Visibility="Collapsed">
                            <Border BorderBrush="{StaticResource DsBorderStrongBrush}" BorderThickness="1" CornerRadius="20" Background="{StaticResource DsSurfaceBrush}" Padding="48,40">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource DsPrimarySoftBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource DsIconFont}" FontSize="26" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="还没有课程" Style="{StaticResource DsH1}" FontSize="19" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                    <TextBlock Text="去主对话写下第一个学习目标，确认计划后就能在这里继续学习。" Style="{StaticResource DsSmall}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                                    <Button Content="去主对话制定学习计划" Click="GoChat_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" AutomationProperties.AutomationId="EmptyGoChat"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid x:Name="CourseMap" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Click="CourseBack_Click" ToolTip="返回我的课程" AutomationProperties.AutomationId="CourseBack" Style="{StaticResource IconButton}" Background="{StaticResource DsSurfaceBrush}" BorderBrush="{StaticResource DsBorderBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource DsIconFont}" FontSize="14" Foreground="{StaticResource DsBodyBrush}"/>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock x:Name="CourseTitle" Text="课程" Style="{StaticResource DsH1}"/>
                                    <TextBlock Text="单击节点查看详情，双击进入课程。路线仅表示建议学习顺序，具体前置关系见右侧详情。" Style="{StaticResource DsSmall}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border Style="{StaticResource DsChipPrimary}" Margin="0,4,8,0"><TextBlock x:Name="CourseProgressChip" Text="0 / 0 课已完成" Style="{StaticResource DsCaption}" Foreground="{StaticResource DsPrimaryBrush}"/></Border>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="352"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DsCard}" Padding="16" Margin="0,0,18,0" Height="576">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel Margin="4,2,4,12">
                                            <TextBlock Text="学习路线" Style="{StaticResource DsH2}"/>
                                            <TextBlock Text="自上而下按建议顺序排列；你的完成情况会随学习自动更新。" Style="{StaticResource DsCaption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ScrollViewer local:SmoothScroll.Enabled="True" x:Name="RouteViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                                            <Canvas x:Name="CourseCanvas" AutomationProperties.AutomationId="CourseGraph"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DsCard}" Padding="22" Height="576">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="课 程 详 情" Style="{StaticResource DsSectionLabel}"/>
                                            <TextBlock x:Name="CourseDetailTitle" Text="选择一个课程节点" Style="{StaticResource DsH2}" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="CourseDetailMeta" Style="{StaticResource DsCaption}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Row="1" Style="{StaticResource DsSoftPanel}" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE946;" Style="{StaticResource DsIconGlyph}" FontSize="12" Foreground="{StaticResource DsPrimaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <TextBlock x:Name="CourseDetailStatus" Style="{StaticResource DsSmall}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBox x:Name="CourseDetailText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="NodeDetail" Margin="0,12,0,12" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13" IsTabStop="False"/>
                                        <StackPanel Grid.Row="3">
                                            <Button Content="开始学习本课" Click="OpenSelectedNode_Click" AutomationProperties.AutomationId="OpenSelectedLesson" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="或双击左侧课程节点直接进入。" Style="{StaticResource DsCaption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource DsCardFlat}" Background="{StaticResource DsSurfaceAltBrush}" Margin="0,16,0,0" Padding="18,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource DsIconGlyph}" FontSize="13" Foreground="{StaticResource DsPrimaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Text="学习提示：理论课答对每道测验后自动完成；实验课由你自行测评并确认，软件不编译或执行代码。前置关系只是建议，你可以从任意一节课开始。" Style="{StaticResource DsSmall}" Margin="9,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Settings ===== -->
                    <StackPanel local:SubtleMotion.Enabled="True" x:Name="SettingsPanel" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="设置" Style="{StaticResource DsDisplay}"/>
                        <TextBlock Text="连接 DeepSeek，让学习计划与课文使用你自己的账户生成。" Style="{StaticResource DsBody}" Foreground="{StaticResource DsMutedBrush}" Margin="0,8,0,24"/>

                        <Border Style="{StaticResource DsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource DsPrimarySoftBrush}">
                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource DsIconGlyph}" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="模型与密钥" Style="{StaticResource DsH2}"/>
                                        <TextBlock Text="密钥使用 Windows DPAPI 加密保存在本机，不会出现在任何界面或日志中。" Style="{StaticResource DsCaption}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="模型名称" Style="{StaticResource DsLabel}"/>
                                <TextBox Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Model"/>
                                <TextBlock Text="API 密钥" Style="{StaticResource DsLabel}" Margin="0,6,0,6"/>
                                <PasswordBox x:Name="ApiKey" Padding="12" MaxLength="4096" PasswordChanged="ApiKey_PasswordChanged" AutomationProperties.Name="API 密钥"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource DsIconGlyph}" FontSize="12" Foreground="{StaticResource DsSuccessBrush}"/>
                                    <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource DsCaption}" Margin="7,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="留空保存不会删除旧密钥。填写新密钥后请点击保存。" Style="{StaticResource DsCaption}" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="保存设置" Click="Save_Click" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="Save" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="放弃未保存输入" Click="Reload_Click" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DsCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource DsPrimarySoftBrush}">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource DsIconGlyph}" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="连接检测" Style="{StaticResource DsH2}"/>
                                        <TextBlock Text="每次独立发送「你是什么模型？」，不携带课程或计划对话。连接结果与模型自述分开展示。" Style="{StaticResource DsCaption}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource DsSoftPanel}" Margin="0,0,0,14">
                                    <TextBlock Text="点击即发送一条固定问题至已保存模型，按服务商计费，不附带任何学习资料或记录。模型自述仅作参考，不用于身份认证。" Style="{StaticResource DsSmall}"/>
                                </Border>
                                <Button Content="检测 DeepSeek 连接" Click="Probe_Click" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="CheckConnection" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource DsSmall}" Margin="0,14,0,0" AutomationProperties.AutomationId="ConnectionStatus"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DsCard}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="数据位置" Style="{StaticResource DsH2}"/>
                                <TextBlock Text="{Binding DataLocation}" TextWrapping="Wrap" Style="{StaticResource DsSmall}" Margin="0,10,0,0" AutomationProperties.AutomationId="DataLocation"/>
                                <TextBlock Text="课程、作答、设置和内部扫描缓存随数据目录保存。迁移保留原目录；外部教材及独立资料库不搬动。" TextWrapping="Wrap" Style="{StaticResource DsCaption}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="迁移当前数据…" Click="MoveData_Click" IsEnabled="{Binding CanChangeDataDirectory}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" AutomationProperties.AutomationId="MoveDataDirectory"/>
                                    <Button Content="切换已有数据…" Click="SwitchData_Click" IsEnabled="{Binding CanChangeDataDirectory}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" AutomationProperties.AutomationId="SwitchDataDirectory"/>
                                    <Button Content="取消待生效更改" Click="CancelDataChange_Click" IsEnabled="{Binding CanChangeDataDirectory}" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding DataDirectoryStatus}" TextWrapping="Wrap" Style="{StaticResource DsCaption}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DsCardFlat}" Background="{StaticResource DsSurfaceAltBrush}" Margin="0,16,0,0" Padding="20,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource DsIconGlyph}" FontSize="13" Foreground="{StaticResource DsMutedBrush}"/>
                                <TextBlock Text="所有资料与学习记录都保存在本机；Deep Study 不会上传你的课程数据。" Style="{StaticResource DsSmall}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource DsSurfaceAltBrush}" Padding="30,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource DsSuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource DsCaption}" MaxHeight="42" AutomationProperties.AutomationId="Status"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="1" Text="Deep Study · 本地学习助手" Style="{StaticResource DsCaption}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
