<Window x:Class="StudyHarness.Desktop.LearningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StudyHarness.Desktop"
        Icon="Assets/deep-study.ico" Title="Deep Study · 学习" WindowState="Maximized" Width="1440" Height="920" MinWidth="1100" MinHeight="720"
        FontFamily="{StaticResource DsFont}" FontSize="13" Background="{StaticResource DsPageBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" ToolTip="返回课程路线" Style="{StaticResource IconButton}" Background="{StaticResource DsSurfaceBrush}" BorderBrush="{StaticResource DsBorderBrush}" VerticalAlignment="Center">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource DsIconFont}" FontSize="14" Foreground="{StaticResource DsBodyBrush}"/>
            </Button>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DsH1}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border Style="{StaticResource DsChipPrimary}"><TextBlock Text="{Binding LessonTypeLabel}" Style="{StaticResource DsCaption}" Foreground="{StaticResource DsPrimaryBrush}"/></Border>
                    <Border Style="{StaticResource DsChip}" Margin="8,0,0,0"><TextBlock Text="阅读位置自动保存" Style="{StaticResource DsCaption}"/></Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="GenerateArticleButton" Content="{Binding GenerateLabel}" Click="Generate_Click" IsEnabled="{Binding CanGenerate}" Style="{StaticResource PrimaryButton}" MinWidth="164" AutomationProperties.AutomationId="GenerateArticle"/>
                <Button Content="取消生成" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Visibility="{Binding IsGenerating,Converter={StaticResource VisibleWhenTrue}}"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail: outline, generation detail, history -->
            <Border Style="{StaticResource DsCard}" Padding="18,18,18,14">
                <ScrollViewer local:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="课 程 目 录" Style="{StaticResource DsSectionLabel}"/>
                        <TextBlock Text="单击切换本课；切换不会丢失已生成内容。" Style="{StaticResource DsCaption}" Margin="0,6,0,10"/>
                        <StackPanel x:Name="OutlinePanel"/>

                        <Separator Margin="0,12,0,10"/>
                        <Expander Header="生成详情与用量">
                            <StackPanel>
                                <TextBlock Text="{Binding Tasks}" Style="{StaticResource DsMono}" FontSize="11.5" Margin="0,0,0,8"/>
                                <Button Content="查看外发详情（可选）" Click="Prepare_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                <Button x:Name="HideEgressButton" Content="隐藏外发详情" Click="HidePreview_Click" Visibility="{Binding HasPreview,Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="HideEgressPreview"/>
                                <TextBox x:Name="EgressPreviewText" Visibility="{Binding HasPreview,Converter={StaticResource VisibleWhenTrue}}" Text="{Binding Preview,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource DsMonoFont}" FontSize="11" Background="{StaticResource DsSurfaceAltBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="历史版本">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" DisplayMemberPath="ArchivedAt"/>
                                <Button Content="阅读所选历史版本" Click="History_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <Button Content="返回当前文章" Click="Open_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Border Style="{StaticResource DsSoftPanel}" Margin="0,8,0,0">
                            <TextBlock Text="实验材料请从课程路线图打开，由你自行测评；软件不编译或执行代码。" Style="{StaticResource DsCaption}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Reader -->
            <Border Grid.Column="2" Style="{StaticResource DsCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource DsSurfaceAltBrush}" CornerRadius="16,16,0,0" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="0,0,0,1" Padding="18,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource DsIconGlyph}" FontSize="12" Foreground="{StaticResource DsPrimaryBrush}"/>
                                <TextBlock Text="{Binding ContentLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DsBodyBrush}" Margin="7,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource DsCaption}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" AutomationProperties.AutomationId="LearningStatus" ToolTip="{Binding Status}"/>
                        </Grid>
                    </Border>
                    <local:LessonWebView x:Name="Reader" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- Tutoring -->
            <local:TutoringPane x:Name="Tutor" Grid.Column="4" Visibility="Collapsed"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="生成将使用当前模型和本课固定资料；取消可能仍产生已发送请求的用量。失败或取消不会替换原文，旧版本可在历史中阅读。" Style="{StaticResource DsCaption}"/>
    </Grid>
</Window>
