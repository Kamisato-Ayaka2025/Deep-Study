<Window x:Class="StudyHarness.Desktop.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请确认" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource DsFont}" FontSize="13.5" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource DsSurfaceBrush}" CornerRadius="20" Padding="26" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" Effect="{StaticResource DsCardShadowHover}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="GlyphTile" Width="42" Height="42" CornerRadius="13" Background="{StaticResource DsPrimarySoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="Glyph" Text="&#xE897;" FontFamily="{StaticResource DsIconFont}" FontSize="18" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="请确认" Style="{StaticResource DsH2}"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource DsCaption}" Margin="0,4,0,0" Text="这个操作需要你的确认"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="MessageText" Style="{StaticResource DsBody}" Margin="0,18,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="88" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="OkButton" Content="确认" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="10,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
