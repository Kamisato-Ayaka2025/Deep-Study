<UserControl x:Class="StudyHarness.Desktop.TutoringPane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StudyHarness.Desktop" MinWidth="300">
    <Border Style="{StaticResource DsCard}" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource DsPrimarySoftBrush}">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource DsIconGlyph}" FontSize="14" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="本课答疑" Style="{StaticResource DsH2}"/>
                        <TextBlock Text="临时会话 · 切课或关闭即清空" Style="{StaticResource DsCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="理论课可详细讲解和举例；实验课提供提示，不代写完整答案。不会修改文件、执行代码或确认完成。" Style="{StaticResource DsCaption}" Margin="0,10,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource DsSurfaceAltBrush}" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,12,0,12">
                <local:TutorMarkdownView x:Name="Dialogue" Background="Transparent" BorderThickness="0" Padding="4" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="TutorDialogue"/>
            </Border>

            <StackPanel Grid.Row="3">
                <TextBlock Text="你的问题（最多 4000 字）" Style="{StaticResource DsLabel}"/>
                <TextBox x:Name="Question" AcceptsReturn="True" TextWrapping="Wrap" Height="76" MaxLength="4000" TextChanged="InputChanged" AutomationProperties.AutomationId="TutorQuestion"/>
                <Expander Header="主动提供代码（可选，UTF-8）" Margin="0,6,0,0">
                    <StackPanel>
                        <Button Content="选择一个代码文件，只读" Click="SelectCode" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                        <TextBox x:Name="Code" AcceptsReturn="True" TextWrapping="Wrap" Height="88" MaxLength="16000" TextChanged="InputChanged" FontFamily="{StaticResource DsMonoFont}" FontSize="11.5" Margin="0,8,0,0"/>
                        <Button Content="清除代码" Click="ClearCode" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>
                <TextBlock Text="发送将使用当前模型，向 DeepSeek 发送本课内容、临时对话、问题及你主动提供的代码。" Style="{StaticResource DsCaption}" Margin="0,8,0,0"/>
                <Button x:Name="PrepareButton" Content="查看发送内容（可选）" Click="PrepareClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                <TextBox x:Name="Preview" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="170" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,8,0,0" FontFamily="{StaticResource DsMonoFont}" FontSize="11" Background="{StaticResource DsSurfaceAltBrush}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="输入问题后点击发送" Style="{StaticResource DsCaption}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="清空" Click="ResetClick" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                        <Button x:Name="SendButton" Content="发送" Click="SendClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" MinWidth="84" Padding="18,8"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Status" Text="输入问题后点击发送即可获得回答。" Style="{StaticResource DsCaption}" Margin="0,8,0,0" MaxHeight="46" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
