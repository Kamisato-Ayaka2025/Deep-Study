<Window x:Class="StudyHarness.Desktop.PlanClarificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/deep-study.ico" Title="补充计划信息" Width="860" Height="800" MinWidth="640" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource DsPageBrush}" FontFamily="{StaticResource DsFont}" FontSize="13.5" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource DsPrimarySoftBrush}">
                    <TextBlock Text="&#xE897;" Style="{StaticResource DsIconGlyph}" FontSize="17" Foreground="{StaticResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="补充计划信息" Style="{StaticResource DsH1}" FontSize="21"/>
                    <TextBlock Text="回答模型提出的问题，计划会更贴合你的实际情况。" Style="{StaticResource DsCaption}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="请逐项回答。接受默认值、没有固定期限或平台，都可以直接说明。保存回答不会立即发送请求。" Style="{StaticResource DsBody}" Foreground="{StaticResource DsMutedBrush}" Margin="0,16,0,0"/>

            <ItemsControl ItemsSource="{Binding ClarificationQuestions}" AutomationProperties.AutomationId="ClarificationQuestions" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DsSoftPanel}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource DsIconGlyph}" FontSize="12" Foreground="{StaticResource DsPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource DsBody}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="你的回答" Style="{StaticResource DsLabel}" Margin="0,8,0,6"/>
            <TextBox Text="{Binding ClarificationAnswer,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanClarify}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ClarificationAnswer"/>
            <Button Content="保存回答并预览外发" Click="SaveAnswer_Click" IsEnabled="{Binding CanClarify}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveClarification" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/>

            <Border Style="{StaticResource DsCard}" Padding="20" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="完整外发预览" Style="{StaticResource DsH2}"/>
                    <TextBlock Text="下面是将发送给 DeepSeek 的全部内容。" Style="{StaticResource DsCaption}" Margin="0,4,0,10"/>
                    <TextBox Text="{Binding Preview,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ClarificationPreview" Background="{StaticResource DsSurfaceAltBrush}" FontFamily="{StaticResource DsMonoFont}" FontSize="11.5"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="同意发送并重新拟定计划" Click="Regenerate_Click" IsEnabled="{Binding CanSendPlan}" AutomationProperties.AutomationId="RegeneratePlan" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                        <Button Content="同意携带错误信息重发尝试" Click="Retry_Click" IsEnabled="{Binding CanRetryPlan}" AutomationProperties.AutomationId="RetryPlan" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                        <Button Content="取消请求" Click="Cancel_Click" AutomationProperties.AutomationId="CancelClarification" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource DsSmall}" Foreground="{StaticResource DsPrimaryBrush}" Margin="0,8,0,0" AutomationProperties.AutomationId="ClarificationStatus"/>
                    <TextBlock Text="{Binding ConfirmationHint}" Style="{StaticResource DsCaption}" Margin="0,5,0,0" AutomationProperties.AutomationId="ClarificationHint"/>
                </StackPanel>
            </Border>

            <Button Content="返回主对话核对完整计划" Click="Return_Click" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ReturnToPlan" Style="{StaticResource GhostButton}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
