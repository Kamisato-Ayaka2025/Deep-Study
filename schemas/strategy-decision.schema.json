{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8 StrategyDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domain", "teachingModes", "reason", "materialCapabilities", "limitations", "clarifications"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domain": { "type": "string", "minLength": 1, "maxLength": 200 },
    "teachingModes": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["theory", "exercise", "project"] } },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "materialCapabilities": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["paper-exercise", "manual-project", "portable-c", "portable-cpp"] } },
    "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "clarifications": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
  }
}
