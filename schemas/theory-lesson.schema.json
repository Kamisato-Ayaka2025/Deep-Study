{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TheoryLesson v1 (host private)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blocks", "questions", "sourceKeys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "blocks": {
      "type": "array", "minItems": 2, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["paragraph", "heading", "code", "math", "diagram", "example", "question"] },
          "text": { "type": ["string", "null"], "maxLength": 16000 },
          "questionId": { "type": ["string", "null"], "maxLength": 80 }
        },
        "if": { "properties": { "kind": { "const": "question" } } },
        "then": { "required": ["questionId"], "properties": { "questionId": { "$ref": "#/$defs/id" }, "text": { "type": "null" } } },
        "else": { "required": ["text"], "properties": { "text": { "$ref": "#/$defs/text" }, "questionId": { "type": "null" } } }
      }
    },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "prompt", "options", "correctOptionId", "explanation"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "prompt": { "$ref": "#/$defs/text" },
          "correctOptionId": { "$ref": "#/$defs/id" },
          "explanation": { "$ref": "#/$defs/text" },
          "options": {
            "type": "array", "minItems": 2, "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "text"],
              "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" } }
            }
          }
        }
      }
    },
    "sourceKeys": { "type": "array", "minItems": 1, "maxItems": 99, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 16000 }
  }
}
