{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "General practice material v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "capability", "title", "objectives", "prerequisites", "tasks", "assessment", "sources"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "kind": { "enum": ["exercise", "project"] },
    "capability": { "enum": ["paper-exercise", "manual-project"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/short" } },
    "prerequisites": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/short" } },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "input", "expectedObservation", "acceptance"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "action": { "$ref": "#/$defs/taskText" },
        "input": { "$ref": "#/$defs/taskText" },
        "expectedObservation": { "$ref": "#/$defs/taskText" },
        "acceptance": { "$ref": "#/$defs/taskText" }
      }
    }},
    "assessment": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "sources": { "type": "array", "minItems": 1, "maxItems": 99, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "exercise" } } }, "then": { "properties": { "capability": { "const": "paper-exercise" } } } },
    { "if": { "properties": { "kind": { "const": "project" } } }, "then": { "properties": { "capability": { "const": "manual-project" } } } }
  ],
  "$defs": {
    "short": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "taskText": { "type": "string", "minLength": 1, "maxLength": 8000 }
  }
}
